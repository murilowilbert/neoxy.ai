# Neoxy.ai - Variáveis de Ambiente

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados (SQLite para dev local zero-custo, ou PostgreSQL para produção/Supabase)
# SQLite dev:
DATABASE_URL="file:./neoxy.db"
# PostgreSQL prod:
# DATABASE_URL="postgresql://user:password@localhost:5432/neoxy?schema=public"

# Google Gemini API
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Cache & Filas Redis (Opcional em dev: o Neoxy usa fallback in-memory automático se o Redis estiver indisponível)
REDIS_URL="redis://localhost:6379"

# Evolution API (WhatsApp Gateway Multi-Instância)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="neoxy-secret-token"

# Segredo de Webhook interno
NEOXY_WEBHOOK_SECRET="neoxy-super-secret"
