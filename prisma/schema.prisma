// Prisma Schema for Neoxy.ai (Multi-Tenant SaaS Architecture)
// Compatible with SQLite for 100% free local development and PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("USER") // "SUPER_ADMIN" | "USER"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  memberships  TenantMember[]
}

model TenantMember {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      String   @default("OWNER") // "OWNER" | "AGENT" | "VIEWER"
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Tenant {
  id               String                 @id @default(uuid())
  slug             String                 @unique // ex: "ferragens-demo", "loja-pet-x", "escritorio-demo"
  name             String
  segment          String                 // ex: "construcao", "petshop", "contabilidade"
  businessType     String                 @default("RETAIL") // "RETAIL" | "SERVICES" | "OFFICE" | "HYBRID"
  enabledModules   String                 @default("[\"stock\"]") // JSON array: ["stock", "services", "appointments", "documents", "crm"]
  active           Boolean                @default(true)
  settings         String                 // JSON serializado contendo persona, horários, regras, templates, catálogo
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  members          TenantMember[]
  whatsappAccounts TenantWhatsAppSession[]
  chatSessions     ChatSession[]
  chatHistory      ChatMessage[]
  missedDemands    MissedDemand[]
  catalogItems     CatalogItem[]
  serviceItems     ServiceItem[]
  professionals    Professional[]
  appointments     Appointment[]
  documents        DocumentSubmission[]
}

model TenantWhatsAppSession {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instanceName String   @unique // Identificador único na Evolution API
  phoneNumber  String?
  status       String   @default("DISCONNECTED") // CONNECTED, QRCODE, DISCONNECTED
  apiKey       String?
  webhookUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model ChatSession {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerPhone   String
  customerName    String?
  state           String   @default("IDLE") // IDLE, AWAITING_TRIAGE_ANSWER, HUMAN_HANDOFF
  stateData       String?  // JSON serializado (contexto de triagem, categoria afunilada)
  lastInteraction DateTime @default(now())
  pausedUntil     DateTime? // Se estiver em handoff / pausa humana

  @@unique([tenantId, customerPhone])
  @@index([tenantId, customerPhone])
}

model ChatMessage {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerPhone String
  role          String   // "user" | "model" | "system" | "human_agent"
  content       String
  mediaType     String?  // "image", "audio", "document"
  mediaUrl      String?
  metadata      String?  // JSON serializado (intent, confidence, tags como [HANDOFF], [NO_RESPONSE])
  createdAt     DateTime @default(now())

  @@index([tenantId, customerPhone, createdAt])
}

model MissedDemand {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productName   String
  searchCount   Int      @default(1)
  lastRequested DateTime @default(now())

  @@unique([tenantId, productName])
  @@index([tenantId])
}

model CatalogItem {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String   // EAN ou Código interno
  name        String
  description String?
  price       Float    @default(0.0)
  stockQty    Float    @default(0.0)
  category    String?
  brand       String?
  tags        String?  // tags separadas por vírgula
  imageUrl    String?
  hasPhoto    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, category])
}

model Professional {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  role          String        @default("Especialista") // ex: "Veterinária", "Tosador Sênior", "Box 01"
  specialty     String?
  commissionPct Float         @default(30.0) // Percentual de comissão sobre o serviço
  phone         String?
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointments  Appointment[]

  @@index([tenantId])
}

model ServiceItem {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMinutes Int           @default(30)
  price           Float         @default(0.0)
  category        String?
  variants        String?       // JSON array: [{"label":"Porte P","durationMinutes":45,"price":55}]
  returnCycleDays Int?          // Ciclo de retorno sugerido em dias (ex: 15, 30, 180)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointments    Appointment[]

  @@index([tenantId])
}

model Appointment {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId        String?
  service          ServiceItem?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professionalId   String?
  professional     Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  customerName     String
  customerPhone    String
  scheduledAt      DateTime
  status           String        @default("CONFIRMED") // "CONFIRMED" | "IN_PROGRESS" | "READY_FOR_PICKUP" | "COMPLETED" | "CANCELLED"
  variantLabel     String?       // ex: "Porte G (acima de 25kg)"
  agreedPrice      Float?        // Valor acordado conforme variação/porte
  agreedDuration   Int?          // Duração acordada em minutos
  checkinChecklist String?       // JSON array de itens conferidos na entrada + vistoria
  returnDueAt      DateTime?     // Data programada para lembrete de retorno
  returnNotified   Boolean       @default(false)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId, scheduledAt])
  @@index([tenantId, customerPhone])
}

model DocumentSubmission {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  docType       String   @default("BOLETO") // "BOLETO" | "NOTA_FISCAL" | "COMPROVANTE" | "CONTRATO" | "OUTRO"
  title         String
  amount        Float?
  dueDate       String?  // YYYY-MM-DD
  fileUrl       String?
  aiSummary     String?  // Resumo extraído pela IA
  status        String   @default("PENDING") // "PENDING" | "REVIEWED" | "PAID" | "ARCHIVED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model AuthSlide {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  badge     String?
  imageUrl  String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
