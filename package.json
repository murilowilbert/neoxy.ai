{
  "name": "neoxy.ai",
  "version": "1.0.0",
  "description": "Plataforma SaaS Multi-Tenant para Atendimento Humanizado de WhatsApp com IA e Gestão de Estoque",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "test:chat": "node scripts/simulate_chat.js",
    "chat": "node scripts/interactive_chat.js",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build"
  },
  "keywords": [
    "whatsapp",
    "multi-tenant",
    "ai",
    "gemini",
    "stock-bot",
    "saas"
  ],
  "author": "Neoxy.ai Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fuse.js": "^7.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0"
  }
}
